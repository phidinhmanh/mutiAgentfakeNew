# =============================================================================
# TRUST Backend Environment Variables Template
# Copy to .env and fill in your actual values
# =============================================================================

# ── Runtime mode ───────────────────────────────────────────────────────────────
# Use development locally. Use production on Railway.
ENVIRONMENT=development

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: google | nvidia | openai | groq
LLM_PROVIDER=google

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (AI Studio) — preferred provider
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemma-4-31b-it

# NVIDIA NIM
NVIDIA_API_KEY=replace-with-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Shared LLM settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Search APIs ───────────────────────────────────────────────────────────────
# At least one required for web evidence retrieval
SERPER_API_KEY=replace-with-serper-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for downloading PhoBERT and embedding models
HF_TOKEN=replace-with-huggingface-token

# Model cache (defaults work for local dev; use volume mounts in production)
HF_HOME=./models_cache
TRANSFORMERS_CACHE=./models_cache/transformers

# ── Deployment ────────────────────────────────────────────────────────────────
# URL của Backend (Railway cấp). Dùng cho logging hoặc các dịch vụ khác.
# Ví dụ: https://trust-backend.up.railway.app
BACKEND_URL=

# URL của Frontend (Vercel/Railway).
# Hỗ trợ nhiều domain cách nhau bằng dấu phẩy.
# Required khi ENVIRONMENT != development.
FRONTEND_URL=
